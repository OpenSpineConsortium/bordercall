      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/tiff</dc:format>
         <dc:identifier>10.1186/s12891-021-04354-x</dc:identifier>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>BMC Musculoskeletal Disorders</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">BMC Musculoskeletal Disorders, 2021, doi:10.1186/s12891-021-04354-x</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Arthroscopy</rdf:li>
               <rdf:li>Opioid sparing</rdf:li>
               <rdf:li>Nonopioid</rdf:li>
               <rdf:li>Randomized controlled trial</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Protocol for a multicenter randomized controlled trial comparing a non-opioid prescription to the standard of care for pain control following arthroscopic knee and shoulder surgery</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Aaron Gazendam</rdf:li>
               <rdf:li>Seper Ekhtiari</rdf:li>
               <rdf:li>Nolan S. Horner</rdf:li>
               <rdf:li>Nicole Simunovic</rdf:li>
               <rdf:li>Andrew Duong</rdf:li>
               <rdf:li>Darren Sa</rdf:li>
               <rdf:li>Devin Peterson</rdf:li>
               <rdf:li>Matthew Denkers</rdf:li>
               <rdf:li>Vickas Khanna</rdf:li>
               <rdf:li>Anthony Adili</rdf:li>
               <rdf:li>Jaydeep Moro</rdf:li>
               <rdf:li>Moin Khan</rdf:li>
               <rdf:li>Olufemi R. Ayeni</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
