"/home/user/bordercall","sessionId":"cbdcd57f-bcf8-5a71-ab64-4f0b9fbdb74f","version":"2.1.314","gitBranch":"HEAD","slug":"zany-kindling-liskov"}
{"parentUuid":"aea2fba2-69a6-4548-9f1d-8d7eea5a6f55","isSidechain":true,"promptId":"b181e0eb-34fb-4b99-8009-91607af5aeb8","agentId":"af4ae0306e46b6e08","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013As6sGn4dGzNrBwXRPCBYV","type":"tool_result","content":"     1\t\"\"\"Raw nanoDRR rendering helpers.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom collections.abc import Mapping\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport torch\n    10\tfrom nanodrr.camera import make_rt_inv\n    11\timport nanodrr.drr as nanodrr_drr\n    12\tfrom torch import Tensor\n    13\t\n    14\tfrom .intrinsics import DRRIntrinsics, build_drr_camera_info, build_render_intrinsics\n    15\tfrom .subjects import subject_from_tensors\n    16\t\n    17\t__all__ = [\"DRRRenderRequest\", \"DRRRenderResult\", \"render_drr\"]\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass DRRRenderRequest:\n    22\t    \"\"\"Per-render pose, camera, and label-output settings.\n    23\t\n    24\t    Attributes:\n    25\t        rot: Per-view ZXY Euler rotations in degrees with shape ``(V, 3)`` or\n    26\t            one rotation with shape ``(3,)``.\n    27\t        xyz: Per-view camera translations with shape matching ``rot``.\n    28\t        intrinsics: Camera intrinsics object or mapping accepted by\n    29\t            ``build_render_intrinsics``.\n    30\t        isocenter: Optional world-space isocenter with shape ``(3,)`` or\n    31\t            per-view shape ``(V, 3)``.\n    32\t        orientation: Optional nanoDRR orientation string.\n    33\t        n_samples: Default number of samples along each projection ray.\n    34\t        orthographic: Optional projection-mode override for ``intrinsics``.\n    35\t        render_soft_labels: Whether projected labels retain soft foreground\n    36\t            values instead of thresholded masks.\n    37\t        seg_threshold: Threshold used for hard projected label masks.\n    38\t        render_kwargs: Additional keyword arguments forwarded to nanoDRR render.\n    39\t    \"\"\"\n    40\t\n    41\t    rot: Tensor\n    42\t    xyz: Tensor\n    43\t    intrinsics: DRRIntrinsics | Mapping[str, Any]\n    44\t    isocenter: Tensor | None = None\n    45\t    orientation: str | None = \"AP\"\n    46\t    n_samples: int = 500\n    47\t    orthographic: bool | None = None\n    48\t    render_soft_labels: bool = False\n    49\t    seg_threshold: float = 0.5\n    50\t    render_kwargs: Mapping[str, Any] = field(default_factory=dict)\n    51\t\n    52\t\n    53\t@dataclass(frozen=True)\n    54\tclass DRRRenderResult:\n    55\t    \"\"\"Rendered raw DRR image, projected labels, and camera metadata.\n    56\t\n    57\t    Attributes:\n    58\t        images: Rendered single-channel DRR images with explicit channel axis.\n    59\t        labels: Projected label masks with explicit background channel.\n    60\t        request: Original render request used to produce the result.\n    61\t        intrinsics: Resolved camera intrinsics used for rendering.\n    62\t        rt_inv: Per-view inverse camera extrinsic matrices passed to nanoDRR.\n    63\t        rendered: Raw multi-channel nanoDRR render output before image and label\n    64\t            projection post-processing.\n    65\t        camera_info: Plain dictionary metadata derived from ``intrinsics``.\n    66\t    \"\"\"\n    67\t\n    68\t    images: Tensor\n    69\t    labels: Tensor\n    70\t    request: DRRRenderRequest\n    71\t    intrinsics: DRRIntrinsics\n    72\t    rt_inv: Tensor\n    73\t    rendered: Tensor\n    74\t\n    75\t    @property\n    76\t    def camera_info(self) -> dict[str, Any]:\n    77\t        \"\"\"Return plain per-view camera metadata for serialization.\n    78\t\n    79\t        Returns:\n    80\t            Dictionary containing camera spacing, offsets, image size, SDD, and\n    81\t            projection mode.\n    82\t        \"\"\"\n    83\t\n    84\t        return build_drr_camera_info(self.intrinsics)\n    85\t\n    86\t\n    87\tdef render_drr(\n    88\t    *,\n    89\t    volume: Tensor,\n    90\t    label: Tensor | None,\n    91\t    affine: Tensor,\n    92\t    request: DRRRenderRequest,\n    93\t    attenuation: float | tuple[float, float] | list[float] | None = None,\n    94\t    attenuated_label_ids: list[int] | tuple[int, ...] | Tensor | None = None,\n    95\t    do_per_label_attenuation: bool = False,\n    96\t    max_label: int | None = None,\n    97\t    attenuation_dist: Mapping[str, Any] | None = None,\n    98\t    foreground_collapse_map: list[int] | tuple[int, ...] | Tensor | None = None,\n    99\t    output_num_label_channels: int | None = None,\n   100\t) -> DRRRenderResult:\n   101\t    \"\"\"Render raw DRR image tensors and explicit-background label masks.\n   102\t\n   103\t    Args:\n   104\t        volume: CT image tensor accepted by ``subject_from_tensors``.\n   105\t        label: Dense integer label tensor aligned with ``volume``, or ``None``.\n   106\t        affine: Voxel-to-world affine matrix.\n   107\t        request: Camera pose, intrinsics, and projection settings.\n   108\t        attenuation: Optional global or per-label attenuation bounds.\n   109\t        attenuated_label_ids: Label ids eligible for per-label attenuation.\n   110\t        do_per_label_attenuation: Whether attenuation is sampled per label id.\n   111\t        max_label: Maximum dense label id to expose to nanoDRR.\n   112\t        attenuation_dist: Optional attenuation sampling distribution config.\n   113\t        foreground_collapse_map: Optional mapping from rendered foreground\n   114\t            channels to output label channel ids, including background id ``0``.\n   115\t        output_num_label_channels: Output channel count when collapsing labels.\n   116\t\n   117\t    Returns:\n   118\t        Render result containing raw DRR images and projected label masks.\n   119\t    \"\"\"\n   120\t\n   121\t    volume_t = torch.as_tensor(volume)\n   122\t    if not volume_t.is_floating_point():\n   123\t        volume_t = volume_t.to(torch.float32)\n   124\t    rot = _pose_tensor(request.rot, \"rot\", reference=volume_t)\n   125\t    xyz = _pose_tensor(request.xyz, \"xyz\", reference=volume_t)\n   126\t    if rot.shape != xyz.shape:\n   127\t        raise ValueError(\"request.rot and request.xyz must have the same shape.\")\n   128\t    num_views = int(rot.shape[0])\n   129\t\n   130\t    intrinsics = _resolve_intrinsics(\n   131\t        request.intrinsics,\n   132\t        num_views=num_views,\n   133\t        reference=volume_t,\n   134\t        orthographic_override=request.orthographic,\n   135\t    )\n   136\t\n   137\t    subject = subject_from_tensors(\n   138\t        volume_t,\n   139\t        label,\n   140\t        affine,\n   141\t        attenuation=attenuation,\n   142\t        attenuated_label_ids=attenuated_label_ids,\n   143\t        do_per_label_attenuation=do_per_label_attenuation,\n   144\t        max_label=max_label,\n   145\t        attenuation_dist=attenuation_dist,\n   146\t    )\n   147\t\n   148\t    isocenter = (\n   149\t        subject.isocenter\n   150\t        if request.isocenter is None\n   151\t        else torch.as_tensor(\n   152\t            request.isocenter,\n   153\t            device=volume_t.device,\n   154\t            dtype=volume_t.dtype,\n   155\t        )\n   156\t    )\n   157\t    rt_inv = _make_rt_inv_per_view(\n   158\t        rot,\n   159\t        xyz,\n   160\t        orientation=request.orientation,\n   161\t        isocenter=isocenter,\n   162\t    )\n   163\t\n   164\t    render_kwargs = dict(request.render_kwargs)\n   165\t    n_samples = int(render_kwargs.pop(\"n_samples\", request.n_samples))\n   166\t    if n_samples < 2:\n   167\t        raise ValueError(\"n_samples must be >= 2.\")\n   168\t    orthographic = bool(render_kwargs.pop(\"orthographic\", intrinsics.orthographic))\n   169\t\n   170\t    rendered = nanodrr_drr.render(\n   171\t        subject=subject,\n   172\t        k_inv=intrinsics.k_inv,\n   173\t        rt_inv=rt_inv,\n   174\t        sdd=intrinsics.sdd,\n   175\t        height=intrinsics.height,\n   176\t        width=intrinsics.width,\n   177\t        n_samples=n_samples,\n   178\t        orthographic=orthographic,\n   179\t        **render_kwargs,\n   180\t    )\n   181\t\n   182\t    images = rendered.sum(dim=1, keepdim=True)\n   183\t    labels = _project_labels(\n   184\t        rendered,\n   185\t        render_soft_labels=bool(request.render_soft_labels),\n   186\t        seg_threshold=float(request.seg_threshold),\n   187\t        foreground_collapse_map=foreground_collapse_map,\n   188\t        output_num_label_channels=output_num_label_channels,\n   189\t    )\n   190\t    result_intrinsics = (\n   191\t        intrinsics\n   192\t        if orthographic == intrinsics.orthographic\n   193\t        else DRRIntrinsics(\n   194\t            k_inv=intrinsics.k_inv,\n   195\t            sdd=intrinsics.sdd,\n   196\t            delx=intrinsics.delx,\n   197\t            dely=intrinsics.dely,\n   198\t            x0=intrinsics.x0,\n   199\t            y0=intrinsics.y0,\n   200\t            height=intrinsics.height,\n   201\t            width=intrinsics.width,\n   202\t            orthographic=orthographic,\n   203\t        )\n   204\t    )\n   205\t\n   206\t    return DRRRenderResult(\n   207\t        images=images,\n   208\t        labels=labels,\n   209\t        request=request,\n   210\t        intrinsics=result_intrinsics,\n   211\t        rt_inv=rt_inv,\n   212\t        rendered=rendered,\n   213\t    )\n   214\t\n   215\t\n   216\tdef _pose_tensor(value: Tensor, name: str, *, reference: Tensor) -> Tensor:\n   217\t    tensor = torch.as_tensor(value, device=reference.device)\n   218\t    if not tensor.is_floating_point():\n   219\t        tensor = tensor.to(reference.dtype)\n   220\t    else:\n   221\t        tensor = tensor.to(dtype=reference.dtype)\n   222\t    if tensor.ndim == 1 and int(tensor.numel()) == 3:\n   223\t        tensor = tensor.reshape(1, 3)\n   224\t    if tensor.ndim != 2 or int(tensor.shape[1]) != 3:\n   225\t        raise ValueError(f\"request.{name} must have shape (3,) or (V, 3).\")\n   226\t    return tensor.contiguous()\n   227\t\n   228\t\n   229\tdef _resolve_intrinsics(\n   230\t    intrinsics: DRRIntrinsics | Mapping[str, Any],\n   231\t    *,\n   232\t    num_views: int,\n   233\t    reference: Tensor,\n   234\t    orthographic_override: bool | None,\n   235\t) -> DRRIntrinsics:\n   236\t    if isinstance(intrinsics, DRRIntrinsics):\n   237\t        orthographic = (\n   238\t            intrinsics.orthographic\n   239\t            if orthographic_override is None\n   240\t            else bool(orthographic_override)\n   241\t        )\n   242\t        if intrinsics.num_views not in (1, num_views):\n   243\t            raise ValueError(\n   244\t                \"DRRIntrinsics must contain one view or match the pose view count.\"\n   245\t            )\n   246\t        if intrinsics.num_views == num_views:\n   247\t            resolved = intrinsics.to(device=reference.device, dtype=reference.dtype)\n   248\t            if resolved.orthographic == orthographic:\n   249\t                return resolved\n   250\t        return build_render_intrinsics(\n   251\t            sdd=intrinsics.sdd,\n   252\t            delx=intrinsics.delx,\n   253\t            dely=intrinsics.dely,\n   254\t            x0=intrinsics.x0,\n   255\t            y0=intrinsics.y0,\n   256\t            height=intrinsics.height,\n   257\t            width=intrinsics.width,\n   258\t            num_views=num_views,\n   259\t            orthographic=orthographic,\n   260\t            device=reference.device,\n   261\t            dtype=reference.dtype,\n   262\t        )\n   263\t\n   264\t    orthographic = bool(\n   265\t        intrinsics.get(\"orthographic\", False)\n   266\t        if orthographic_override is None\n   267\t        else orthographic_override\n   268\t    )\n   269\t    return build_render_intrinsics(\n   270\t        sdd=intrinsics[\"sdd\"],\n   271\t        delx=intrinsics[\"delx\"],\n   272\t        dely=intrinsics[\"dely\"],\n   273\t        x0=intrinsics.get(\"x0\", 0.0),\n   274\t        y0=intrinsics.get(\"y0\", 0.0),\n   275\t        height=int(intrinsics[\"height\"]),\n   276\t        width=int(intrinsics[\"width\"]),\n   277\t        num_views=num_views,\n   278\t        orthographic=orthographic,\n   279\t        device=reference.device,\n   280\t        dtype=reference.dtype,\n   281\t    )\n   282\t\n   283\t\n   284\tdef _make_rt_inv_per_view(\n   285\t    rot: Tensor,\n   286\t    xyz: Tensor,\n   287\t    *,\n   288\t    orientation: str | None,\n   289\t    isocenter: Tensor,\n   290\t) -> Tensor:\n   291\t    if isocenter.ndim == 1:\n   292\t        if int(isocenter.numel()) != 3:\n   293\t            raise ValueError(\"isocenter must have shape (3,) or (V, 3).\")\n   294\t        return make_rt_inv(rot, xyz, orientation=orientation, isocenter=isocenter)\n   295\t    if isocenter.ndim == 2:\n   296\t        if isocenter.shape != rot.shape:\n   297\t            raise ValueError(\n   298\t                \"Per-view isocenter must have shape (V, 3) matching request.rot.\"\n   299\t            )\n   300\t        return torch.cat(\n   301\t            [\n   302\t                make_rt_inv(\n   303\t                    rot[idx : idx + 1],\n   304\t                    xyz[idx : idx + 1],\n   305\t                    orientation=orientation,\n   306\t                    isocenter=isocenter[idx],\n   307\t                )\n   308\t                for idx in range(int(rot.shape[0]))\n   309\t            ],\n   310\t            dim=0,\n   311\t        )\n   312\t    raise ValueError(\"isocenter must have shape (3,) or (V, 3).\")\n   313\t\n   314\t\n   315\tdef _project_labels(\n   316\t    rendered: Tensor,\n   317\t    *,\n   318\t    render_soft_labels: bool,\n   319\t    seg_threshold: float,\n   320\t    foreground_collapse_map: list[int] | tuple[int, ...] | Tensor | None = None,\n   321\t    output_num_label_channels: int | None = None,\n   322\t) -> Tensor:\n   323\t    if rendered.ndim != 4:\n   324\t        raise ValueError(\"nanoDRR render output must have shape (V, C, H, W).\")\n   325\t    foreground = rendered[:, 1:, :, :]\n   326\t    if render_soft_labels:\n   327\t        foreground_out = foreground.clamp(0.0, 1.0)\n   328\t        soft_background = True\n   329\t    else:\n   330\t        foreground_out = (foreground > seg_threshold).to(dtype=rendered.dtype)\n   331\t        soft_background = False\n   332\t\n   333\t    if foreground_collapse_map is not None:\n   334\t        foreground_out = _collapse_foreground_channels(\n   335\t            foreground_out,\n   336\t            foreground_collapse_map,\n   337\t            output_num_label_channels=output_num_label_channels,\n   338\t        )\n   339\t    elif foreground_out.shape[1] == 0:\n   340\t        output_channels = (\n   341\t            1 if output_num_label_channels is None else int(output_num_label_channels)\n   342\t        )\n   343\t        if output_channels <= 0:\n   344\t            raise ValueError(\"output_num_label_channels must be positive.\")\n   345\t        foreground_out = rendered.new_zeros(\n   346\t            rendered.shape[0], output_channels - 1, rendered.shape[2], rendered.shape[3]\n   347\t        )\n   348\t\n   349\t    if foreground_out.shape[1] == 0:\n   350\t        background = torch.ones(\n   351\t            rendered.shape[0],\n   352\t            1,\n   353\t            rendered.shape[2],\n   354\t            rendered.shape[3],\n   355\t            device=rendered.device,\n   356\t            dtype=rendered.dtype,\n   357\t        )\n   358\t    else:\n   359\t        foreground_union = foreground_out.amax(dim=1, keepdim=True)\n   360\t        if soft_background:\n   361\t            background = (1.0 - foreground_union).clamp(0.0, 1.0)\n   362\t        else:\n   363\t            background = (foreground_union <= 0).to(dtype=rendered.dtype)\n   364\t    return torch.cat([background, foreground_out], dim=1)\n   365\t\n   366\t\n   367\tdef _collapse_foreground_channels(\n   368\t    foreground: Tensor,\n   369\t    collapse_map: list[int] | tuple[int, ...] | Tensor,\n   370\t    *,\n   371\t    output_num_label_channels: int | None,\n   372\t) -> Tensor:\n   373\t    \"\"\"Collapse rendered foreground masks into output model channels.\n   374\t\n   375\t    Args:\n   376\t        foreground: Rendered foreground masks shaped ``(V, C_fg, H, W)``.\n   377\t        collapse_map: Target output channel id for each foreground channel.\n   378\t        output_num_label_channels: Total output channels including background.\n   379\t\n   380\t    Returns:\n   381\t        Foreground masks shaped ``(V, output_num_label_channels - 1, H, W)``.\n   382\t\n   383\t    Raises:\n   384\t        ValueError: If the collapse map length or target ids are invalid.\n   385\t    \"\"\"\n   386\t\n   387\t    targets = torch.as_tensor(collapse_map, device=foreground.device, dtype=torch.long)\n   388\t    targets = targets.reshape(-1)\n   389\t    if int(targets.numel()) != int(foreground.shape[1]):\n   390\t        raise ValueError(\n   391\t            \"foreground_collapse_map length must match rendered foreground \"\n   392\t            f\"channels ({foreground.shape[1]}), got {targets.numel()}.\"\n   393\t        )\n   394\t    if torch.any(targets < 0):\n   395\t        raise ValueError(\"foreground_collapse_map target ids must be non-negative.\")\n   396\t\n   397\t    if output_num_label_channels is None:\n   398\t        output_channels = int(targets.max().item()) + 1 if targets.numel() else 1\n   399\t    else:\n   400\t        output_channels = int(output_num_label_channels)\n   401\t    if output_channels <= 0:\n   402\t        raise ValueError(\"output_num_label_channels must be positive.\")\n   403\t    if targets.numel() and int(targets.max().item()) >= output_channels:\n   404\t        raise ValueError(\n   405\t            \"foreground_collapse_map target ids must be less than \"\n   406\t            \"output_num_label_channels.\"\n   407\t        )\n   408\t\n   409\t    collapsed = foreground.new_zeros(\n   410\t        foreground.shape[0],\n   411\t        output_channels - 1,\n   412\t        foreground.shape[2],\n   413\t        foreground.shape[3],\n   414\t    )\n   415\t    for source_idx, target_id_t in enumerate(targets.tolist()):\n   416\t        target_id = int(target_id_t)\n   417\t        if target_id <= 0:\n   418\t            continue\n   419\t        target = collapsed[:, target_id - 1]\n   420\t        collapsed[:, target_id - 1] = torch.maximum(target, foreground[:, source_idx])\n   421\t    return collapsed","is_error":false}]},"uuid":"aedcc371-4f03-4d55-bf53-bc19917eb8cf","timestamp":"2026-10-30T18:11:45.044Z","serverClassifierContext":{"request":"f424d732-90ed-49bd-b81f-e692a684c77b","context":{"git_state":{"cwd":"/home/user/bordercall","root":"/home/user/bordercall","branch":"claude/project-thread-gv744i","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":6},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"OpenSpineConsortium/symphony-template","visibility":"unknown"},{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"},{"host":"github.com","remote":"OpenSpineConsortium/SchwingNet","visibility":"unknown"}]}},"live_cwd":"/home/user/bordercall","platform":"linux"}},"sandboxed":fal