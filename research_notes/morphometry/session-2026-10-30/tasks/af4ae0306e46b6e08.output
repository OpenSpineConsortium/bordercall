{"parentUuid":"8b304504-c7d2-4279-96f0-e001a3eac056","isSidechain":true,"promptId":"b181e0eb-34fb-4b99-8009-91607af5aeb8","agentId":"af4ae0306e46b6e08","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SFhvfxLVYisddBStFeNbgK","type":"tool_result","content":"     1\t\"\"\"python -m morphoview render (the package's docstring says what it draws), and python -m\n     2\tmorphoview project, which carries the lines export onto a FleXray render (cmd_project says how).\"\"\"\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport argparse\n     6\timport csv\n     7\timport glob\n     8\timport hashlib\n     9\timport json\n    10\timport math\n    11\timport os\n    12\timport sys\n    13\tfrom typing import Dict, List, Optional, Tuple\n    14\t\n    15\timport numpy as np\n    16\t\n    17\tfrom maskedge import edge as E\n    18\tfrom morphometry import column as COL\n    19\tfrom morphometry import measure as M\n    20\tfrom scanimport import LEVELS\n    21\tfrom scanimport import volume as V\n    22\t\n    23\tfrom . import lines as LN\n    24\tfrom . import projection as PJ\n    25\tfrom . import render as R\n    26\tfrom . import shapes as SH\n    27\t\n    28\tCOLUMNS = [\"study\", \"level\", \"key\", \"rule\", \"panel\", \"value\", \"measured\", \"drawn\", \"status\",\n    29\t           \"ax\", \"ay\", \"az\", \"bx\", \"by\", \"bz\"]\n    30\t\n    31\t\n    32\tdef rows_measured(path: Optional[str], study: str) -> Optional[Dict[str, Dict[str, float]]]:\n    33\t    \"\"\"The run's rows for the study, level by level, where a rows file is given.\"\"\"\n    34\t    if not path:\n    35\t        return None\n    36\t    out: Dict[str, Dict[str, float]] = {}\n    37\t    with open(path, newline=\"\") as fh:\n    38\t        for r in csv.DictReader(fh):\n    39\t            if r[\"study\"] != study or r[\"key\"].startswith(\"flag:\"):\n    40\t                continue\n    41\t            try:\n    42\t                out.setdefault(r[\"level\"], {})[r[\"key\"]] = float(r[\"value\"])\n    43\t            except ValueError:\n    44\t                continue\n    45\t    return out\n    46\t\n    47\t\n    48\tdef neighbours(level: str, have: List[str], present) -> List[tuple]:\n    49\t    \"\"\"The discs above and below the level that the volume holds both bodies of.\"\"\"\n    50\t    order = [lv for lv in LEVELS if lv in have]\n    51\t    i = order.index(level)\n    52\t    out = []\n    53\t    if i > 0 and M.adjacent(order[i - 1], level, present):\n    54\t        out.append((order[i - 1], level))\n    55\t    if i + 1 < len(order) and M.adjacent(level, order[i + 1], present):\n    56\t        out.append((level, order[i + 1]))\n    57\t    return out\n    58\t\n    59\t\n    60\tdef lines_for(vs, level: str, present, measured: Optional[Dict[str, Dict[str, float]]]) -> List[LN.Line]:\n    61\t    v = vs[level]\n    62\t    vals, _, ped = M.vertebra_values(v)\n    63\t    places = LN.ROWS_PLACES if measured is not None else None\n    64\t    got = LN.checked(LN.vertebra_lines(v, ped), measured.get(level, {}) if measured is not None else vals, places)\n    65\t    for up, low in neighbours(level, list(vs), present):\n    66\t        U, L = vs[up], vs[low]\n    67\t        if U.touching[U.body].any() or L.touching[L.body].any():\n    68\t            continue\n    69\t        name = \"%s-%s\" % (up, low)\n    70\t        ref = measured.get(name, {}) if measured is not None else COL.disc_heights(U, L)\n    71\t        got += LN.checked(LN.discs(U, L), ref, places)\n    72\t    return got\n    73\t\n    74\t\n    75\tdef csv_rows(study: str, lines: List[LN.Line]) -> List[dict]:\n    76\t    rows = []\n    77\t    for ln in lines:\n    78\t        rows.append({\"study\": study, \"level\": ln.level, \"key\": ln.key, \"rule\": ln.rule, \"panel\": R.panel_of(ln),\n    79\t                     \"value\": float(ln.value), \"measured\": float(ln.measured), \"drawn\": ln.drawn, \"status\": ln.status,\n    80\t                     \"ax\": float(ln.a[0]), \"ay\": float(ln.a[1]), \"az\": float(ln.a[2]),\n    81\t                     \"bx\": float(ln.b[0]), \"by\": float(ln.b[1]), \"bz\": float(ln.b[2])})\n    82\t    return rows\n    83\t\n    84\t\n    85\tdef caption(study: str, level: str, lines: List[LN.Line]) -> str:\n    86\t    drawn = sum(ln.status == \"drawn\" for ln in lines)\n    87\t    held = sum(ln.status.startswith(\"withheld\") for ln in lines)\n    88\t    return (\"Study %s, %s: %d measures drawn where morphometry takes them, each rebuilt and matched to its row; \"\n    89\t            \"%d withheld. Calipers mark lengths, dashed lines the end-plates rim to rim, dotted lines Eisenstein's \"\n    90\t            \"apex-to-apex line; (p) marks a projected line. Grey: the vertebra measured.\" % (study, level, drawn, held))\n    91\t\n    92\t\n    93\tdef cmd_render(a) -> None:\n    94\t    from schwingcheck import figures as FIG\n    95\t    os.makedirs(a.out, exist_ok=True)\n    96\t    vol, grid, names, _, _ = V.read_labels(a.labels, a.scheme)\n    97\t    vs = E.vertebrae(vol, grid, names)\n    98\t    present = set(names.values())\n    99\t    measured = rows_measured(a.rows, a.study)\n   100\t    for level in a.levels:\n   101\t        if level not in vs:\n   102\t            print(\"%s: not held whole by the volume, or not usable\" % level)\n   103\t            continue\n   104\t        got = lines_for(vs, level, present, measured)\n   105\t        name = \"render-%s-%s\" % (a.study, level)\n   106\t        fig = R.figure(vs[level], vol, R.mine_of(names, level), got, a.study)\n   107\t        cap = caption(a.study, level, got)\n   108\t        assert FIG.words(cap) <= FIG.CAPTION_WORDS, FIG.words(cap)\n   109\t        FIG.save(fig, a.out, name, cap)\n   110\t        FIG.write_csv(a.out, name, csv_rows(a.study, got))\n   111\t        held = [ln for ln in got if ln.status.startswith(\"withheld\")]\n   112\t        print(\"%s: %d lines, %d drawn, %d withheld%s\" % (name, len(got), sum(ln.status == \"drawn\" for ln in got),\n   113\t                                                        len(held), \"\".join(\"\\n  %s %s\" % (h.key, h.status) for h in held)))\n   114\t    write_index(a)\n   115\t\n   116\t\n   117\tdef code_files() -> List[str]:\n   118\t    here = os.path.dirname(os.path.abspath(__file__))\n   119\t    return sorted(glob.glob(os.path.join(here, \"*.py\")))\n   120\t\n   121\t\n   122\tdef write_index(a) -> None:\n   123\t    \"\"\"FIGURES.md beside the figures: the mask and the rows they were drawn from and the code that\n   124\t    drew them, each by sha256.\"\"\"\n   125\t    from schwingcheck import figures as FIG\n   126\t    path = os.path.join(a.out, \"FIGURES.md\")\n   127\t    lines = [\"# Renders of the measures on their slices\", \"\",\n   128\t             \"Drawn by `python -m morphoview render`; every line rebuilt from the measuring code and matched to \"\n   129\t             \"its row (morphoview/__init__.py).\", \"\", \"## Records\", \"\"]\n   130\t    lines.append(\"- study %s: %s, sha256 %s\" % (a.study, os.path.basename(a.labels), FIG.sha256(a.labels)))\n   131\t    if a.rows:\n   132\t        lines.append(\"- rows: %s, sha256 %s\" % (os.path.basename(a.rows), FIG.sha256(a.rows)))\n   133\t    lines += [\"\", \"## Code\", \"\"]\n   134\t    lines += [\"- morphoview/%s %s\" % (os.path.basename(p), FIG.sha256(p)) for p in code_files()]\n   135\t    lines += [\"\", \"## Figures\", \"\"]\n   136\t    lines += [\"- %s\" % os.path.basename(p) for p in sorted(glob.glob(os.path.join(a.out, \"render-*.png\")))]\n   137\t    with open(path, \"w\", encoding=\"ascii\", newline=\"\\n\") as fh:\n   138\t        fh.write(\"\\n\".join(lines) + \"\\n\")\n   139\t\n   140","is_error":false}]},"uuid":"bc7c750b-aee2-4433-ae50-a10034636d36","timestamp":"2026-10-30T18:11:02.731Z","serverClassifierContext":{"request":"0c65bcab-f3ba-4a9b-96c1-a46ced08b156","context":{"git_state":{"cwd":"/home/user/bordercall","root":"/home/user/bordercall","branch":"claude/project-thread-gv744i","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":6},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"OpenSpineConsortium/symphony-template","visibility":"unknown"},{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"},{"host":"github.com","remote":"OpenSpineConsortium/SchwingNet","visibility":"unknown"}]}},"live_cwd":"/home/user/bordercall","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"8b304504-c7d2-4279-96f0-e001a3eac056","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"remote_projects","cwd":"/home/user/bordercall","sessionId":"cbdcd57f-bcf8-5a71-ab64-4f0b9fbdb74f","version":"2.1.314","gitBranch":"HEAD","slug":"zany-kindling-liskov"}
{"parentUuid":"fbfbc8d1-a486-4def-b154-ef6329b140e1","isSidechain":true,"promptId":"b181e0eb-34fb-4b99-8009-91607af5aeb8","agentId":"af4ae0306e46b6e08","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PZnr3FcRTXHvCjjcyCRLjU","type":"tool_result","content":"     1\t\"\"\"Shapes beside the straight lines: curves, arcs, circles, ellipses and splines, planes and flat\n     2\tpolygons, and volumes, each in the world's millimetres of a mask's affine, as morphoview.lines'\n     3\tends are, and each carried onto a FleXray render by morphoview.projection's camera.\n     4\t\n     5\tA curve is a polyline, open or closed. An arc, a circle, an ellipse and a spline are curves\n     6\tsampled finely enough that no point of the true shape lies further than a tolerance from the\n     7\tpolyline (0.05 mm unless asked otherwise), so every curve projects the same way: a straight\n     8\tsegment of the world is a straight segment of the render, its ends projected, so a polyline\n     9\tprojects exactly, and a smooth curve within its tolerance times the magnification. A segment that\n    10\truns behind the source is cut where it reaches the source's plane, since no ray of the render\n    11\tpasses behind the source, and what is left of the curve is kept as the pieces it falls into.\n    12\t\n    13\tA plane is a point and a unit normal, fitted to points by least squares where it is not given\n    14\t(the smallest singular vector of the centred points, with its root mean square residual); its\n    15\tpatch is a flat polygon, a rectangle about the point unless corners are given, and a flat polygon\n    16\tprojects as a closed curve. How the render sees a plane is the angle the ray through its point\n    17\tmakes with it: none where the plane is seen edge on, as a line, and 90 degrees face on.\n    18\t\n    19\tA volume is a label's voxels on its grid, the largest connected piece unless asked otherwise.\n    20\tIts projection is an image on the render's detector: the length in mm each ray runs through the\n    21\tvolume (path_length), and the silhouette, where that length is above zero. Two samplings are\n    22\toffered. The fine one walks each ray through the volume's box at most half the smallest voxel\n    23\tspacing apart, which is the geometric chord to about a voxel. The FleXray one samples the ray as\n    24\tnanoDRR does (nanodrr/drr/renderer.py, render: n points from the source to the detector, each\n    25\tthe label of its nearest voxel as grid_sample's nearest mode reads it, every point weighing the\n    26\tstep), so where the volume's path_length is above zero FleXray's channel for its label is too on\n    27\ta render of attenuating voxels, FleXray's channel being the attenuation summed over the same\n    28\tpoints (fxr/drr/rendering.py, render_drr's rendered).\n    29\t\"\"\"\n    30\tfrom __future__ import annotations\n    31\t\n    32\timport math\n    33\tfrom dataclasses import dataclass\n    34\tfrom typing import Callable, List, Optional, Tuple\n    35\t\n    36\timport numpy as np\n    37\tfrom scipy import ndimage\n    38\t\n    39\tfrom .projection import Camera, Projected\n    40\t\n    41\tTOLERANCE_MM = 0.05             # how far a sampled curve may lie from the true one\n    42\tNEAR = 1e-6                     # a segment is cut this far in front of the source, in mm\n    43\tMOST_SAMPLES = 1 << 16          # the most points one span or one closed shape is sampled at\n    44\t\n    45\t\n    46\tdef unit(v) -> np.ndarray:\n    47\t    v = np.asarray(v, float)\n    48\t    n = float(np.linalg.norm(v))\n    49\t    if not n > 0:\n    50\t        raise ValueError(\"a direction of zero length\")\n    51\t    return v / n\n    52\t\n    53\t\n    54\tdef across(normal) -> Tuple[np.ndarray, np.ndarray]:\n    55\t    \"\"\"Two unit directions across a normal, right-handed with it.\"\"\"\n    56\t    n = unit(normal)\n    57\t    seed = np.eye(3)[int(np.argmin(np.abs(n)))]\n    58\t    e1 = unit(np.cross(n, seed))\n    59\t    return e1, np.cross(n, e1)\n    60\t\n    61\t\n    62\t# ---- curves ---------------------------------------------------------------------------------\n    63\t\n    64\t@dataclass(frozen=True)\n    65\tclass Curve2D:\n    66\t    \"\"\"A curve on a render: its points' places (Projected.uv), depths and whether the render\n    67\t    sampled each, in order; the index where each of its pieces starts, one piece unless the\n    68\t    source's plane cut it; closed when it is one piece whose last point joins its first.\"\"\"\n    69\t    uv: np.ndarray\n    70\t    depth: np.ndarray\n    71\t    in_beam: np.ndarray\n    72\t    closed: bool = False\n    73\t    starts: Tuple[int, ...] = (0,)\n    74\t\n    75\t    def pieces(self) -> List[np.ndarray]:\n    76\t        ends = list(self.starts[1:]) + [len(self.uv)]\n    77\t        return [self.uv[s:e] for s, e in zip(self.starts, ends)]\n    78\t\n    79\t    def length_px(self) -> float:\n    80\t        total = 0.0\n    81\t        for piece in self.pieces():\n    82\t            pts = np.vstack([piece, piece[:1]]) if self.closed else piece\n    83\t            total += float(np.linalg.norm(np.diff(pts, axis=0), axis=1).sum())\n    84\t        return total\n    85\t\n    86\t    def area_px(self) -> float:\n    87\t        \"\"\"The area a closed curve encloses on the render, by the shoelace rule.\"\"\"\n    88\t        if not self.closed:\n    89\t            raise ValueError(\"only a closed curve encloses an area\")\n    90\t        u, v = self.uv[:, 0], self.uv[:, 1]\n    91\t        return 0.5 * abs(float(np.dot(u, np.roll(v, -1)) - np.dot(v, np.roll(u, -1))))\n    92\t\n    93\t\n    94\t@dataclass(frozen=True)\n    95\tclass Curve:\n    96\t    \"\"\"A polyline in the world, open or closed.\"\"\"\n    97\t    points: np.ndarray\n    98\t    closed: bool = False\n    99\t\n   100\t    def __post_init__(self):\n   101\t        pts = np.atleast_2d(np.asarray(self.points, float))\n   102\t        if pts.ndim != 2 or pts.shape[1] != 3 or len(pts) < 2:\n   103\t            raise ValueError(\"a curve is two or more points in three dimensions\")\n   104\t        if not np.isfinite(pts).all():\n   105\t            raise ValueError(\"a curve's points are finite\")\n   106\t        object.__setattr__(self, \"points\", pts)\n   107\t\n   108\t    def segments(self) -> np.ndarray:\n   109\t        pts = np.vstack([self.points, self.points[:1]]) if self.closed else self.points\n   110\t        return np.stack([pts[:-1], pts[1:]], axis=1)\n   111\t\n   112\t    def length(self) -> float:\n   113\t        seg = self.segments()\n   114\t        return float(np.linalg.norm(seg[:, 1] - seg[:, 0], axis=1).sum())\n   115\t\n   116\t    def resampled(self, step: float) -> \"Curve\":\n   117\t        \"\"\"The curve with points at most `step` mm apart along it, its corners kept, so the\n   118\t        polyline is the same.\"\"\"\n   119\t        out = []\n   120\t        for a, b in self.segments():\n   121\t            n = max(1, int(math.ceil(float(np.linalg.norm(b - a)) / step)))\n   122\t            out.append(a + np.linspace(0.0, 1.0, n, endpoint=False)[:, None] * (b - a))\n   123\t        if not self.closed:\n   124\t            out.append(self.points[-1:])\n   125\t        return Curve(np.vstack(out), self.closed)\n   126\t\n   127\t    def project(self, camera: Camera) -> Curve2D:\n   128\t        \"\"\"The curve on the render: each segment cut where it runs behind the source, then its\n   129\t        points projected; a closed curve cut so becomes the open pieces left of it.\"\"\"\n   130\t        pts, starts = in_front(self.segments(), camera, closed=self.closed)\n   131\t        got = camera.project(pts)\n   132\t        cut = starts is not None\n   133\t        return Curve2D(got.uv, got.depth, got.in_beam, self.closed and not cut, tuple(starts or (0,)))\n   134\t\n   135\t\n   136\tdef in_front(segments: np.ndarray, camera: Camera, closed: bool) -> Tuple[np.ndarray, Optional[List[int]]]:\n   137\t    \"\"\"A polyline's points with each segment cut to the part in front of the source's plane, and\n   138\t    the index where each piece left starts, or None where nothing was cut. Parallel rays reach\n   139\t    behind nothing they render, so under them the points stand as they are.\"\"\"\n   140\t    whole = segments[:, 0] if closed else np.vstack([segments[:, 0], segments[-1:, 1]])\n   141\t    depth = camera.camera_points(whole)[:, 2]\n   142\t    if camera.view.orthographic or bool((depth > NEAR).all()):\n   143\t        return whole, None\n   144\t    out: List[np.ndarray] = []\n   145\t    starts: List[int] = []\n   146\t    joined = False\n   147\t    for a, b in segments:\n   148\t        za, zb = camera.camera_points(np.stack([a, b]))[:, 2]\n   149\t        if za <= NEAR and zb <= NEAR:\n   150\t            joined = False\n   151\t            continue\n   152\t        if za <= NEAR or zb <= NEAR:\n   153\t            p = a + (NEAR - za) / (zb - za) * (b - a)\n   154\t            a, b = (p, b) if za <= NEAR else (a, p)\n   155\t        if not joined:\n   156\t            starts.append(len(out))\n   157\t            out.append(a)\n   158\t        out.append(b)\n   159\t        joined = zb > NEAR\n   160\t    if not out:\n   161\t        raise ValueError(\"the curve lies wholly behind the source\")\n   162\t    if closed and joined and len(starts) > 1:\n   163\t        # the last piece runs on through the curve's first point into the first piece\n   164\t        merged = out[starts[-1]:-1] + out[:starts[1]]\n   165\t        rest = out[starts[1]:starts[-1]]\n   166\t        starts = [0] + [s - starts[1] + len(merged) for s in starts[1:-1]]\n   167\t        out = merged + rest\n   168\t    return np.stack(out), starts\n   169\t\n   170\t\n   171\tdef segments_needed(radius: float, angle: float, tolerance: float) -> int:\n   172\t    \"\"\"How many chords an arc of `radius` and `angle` radians needs so that none lies further\n   173\t    than `tolerance` from it: a chord's sagitta is r (1 - cos(t / 2)).\"\"\"\n   174\t    if tolerance >= radius:\n   175\t        return max(1, int(math.ceil(abs(angle) / math.pi)))\n   176\t    step = 2.0 * math.acos(1.0 - tolerance / radius)\n   177\t    return max(1, int(math.ceil(abs(angle) / step)))\n   178\t\n   179\t\n   180\tdef arc(centre, normal, start, angle_deg: float, tolerance: float = TOLERANCE_MM) -> Curve:\n   181\t    \"\"\"The arc about `centre` in the plane of `normal`, from `start`'s place in that plane,\n   182\t    turning `angle_deg` the right-handed way about the normal; open.\"\"\"\n   183\t    centre, n = np.asarray(centre, float), unit(normal)\n   184\t    r0 = np.asarray(start, float) - centre\n   185\t    r0 = r0 - (r0 @ n) * n\n   186\t    radius = float(np.linalg.norm(r0))\n   187\t    if not radius > 0:\n   188\t        raise ValueError(\"an arc's start lies on its axis\")\n   189\t    e1 = r0 / radius\n   190\t    e2 = np.cross(n, e1)\n   191\t    angle = math.radians(angle_deg)\n   192\t    t = np.linspace(0.0, angle, segments_needed(radius, angle, tolerance) + 1)\n   193\t    return Curve(centre + radius * (np.cos(t)[:, None] * e1 + np.sin(t)[:, None] * e2))\n   194\t\n   195\t\n   196\tdef circle(centre, normal, radius: float, tolerance: float = TOLERANCE_MM) -> Curve:\n   197\t    \"\"\"The circle of `radius` about `centre` in the plane of `normal`, closed.\"\"\"\n   198\t    centre, n = np.asarray(centre, float), unit(normal)\n   199\t    e1, e2 = across(n)\n   200\t    k = max(3, segments_needed(radius, 2.0 * math.pi, tolerance))\n   201\t    t = np.linspace(0.0, 2.0 * math.pi, k, endpoint=False)\n   202\t    return Curve(centre + radius * (np.cos(t)[:, None] * e1 + np.sin(t)[:, None] * e2), closed=True)\n   203\t\n   204\t\n   205\tdef ellipse(centre, semi_a, semi_b, tolerance: float = TOLERANCE_MM) -> Curve:\n   206\t    \"\"\"The ellipse about `centre` whose semi-axes are the perpendicular vectors semi_a and semi_b,\n   207\t    closed, its points c + cos t a + sin t b, as many as keep every chord within the tolerance.\"\"\"\n   208\t    centre, a, b = (np.asarray(x, float) for x in (centre, semi_a, semi_b))\n   209\t    la, lb = float(np.linalg.norm(a)), float(np.linalg.norm(b))\n   210\t    if not (la > 0 and lb > 0):\n   211\t        raise ValueError(\"an ellipse's semi-axes have length\")\n   212\t    if abs(float(a @ b)) > 1e-9 * la * lb:\n   213\t        raise ValueError(\"an ellipse's semi-axes are perpendicular\")\n   214\t\n   215\t    def at(t: np.ndarray) -> np.ndarray:\n   216\t        return centre + np.cos(t)[:, None] * a + np.sin(t)[:, None] * b\n   217\t\n   218\t    k = max(3, segments_needed(max(la, lb), 2.0 * math.pi, tolerance))\n   219\t    return Curve(refined(at, 0.0, 2.0 * math.pi, k, tolerance, closed=True), closed=True)\n   220\t\n   221\t\n   222\tdef refined(at: Callable[[np.ndarray], np.ndarray], start: float, stop: float, k: int, tolerance: float,\n   223\t            closed: bool) -> np.ndarray:\n   224\t    \"\"\"A curve's points at k even steps of its parameter from start to stop, k doubled until each\n   225\t    step's midpoint lies within the tolerance of its chord's; the stop's point left off, for a\n   226\t    closed curve or the next span to give.\"\"\"\n   227\t    while True:\n   228\t        fine = at(np.linspace(start, stop, 2 * k + 1))\n   229\t        coarse = fine[::2]\n   230\t        mid = 0.5 * (coarse[:-1] + coarse[1:])\n   231\t        if float(np.linalg.norm(fine[1::2] - mid, axis=1).max()) <= tolerance or k >= MOST_SAMPLES:\n   232\t            return coarse[:-1]\n   233\t        k *= 2\n   234\t\n   235\t\n   236\tdef spline(points, closed: bool = False, tolerance: float = TOLERANCE_MM) -> Curve:\n   237\t    \"\"\"The centripetal Catmull-Rom spline through the points, which passes through every one and,\n   238\t    alone of the Catmull-Rom splines, forms no cusp and no loop within a span (Yuksel, Schaefer and\n   239\t    Keyser 2011), each span sampled until halving its step moves no sample point by more than the\n   240\t    tolerance.\"\"\"\n   241\t    pts = np.atleast_2d(np.asarray(points, float))\n   242\t    if len(pts) < 2 or pts.shape[1] != 3:\n   243\t        raise ValueError(\"a spline needs two or more points in three dimensions\")\n   244\t    ring = np.vstack([pts, pts[:1]]) if closed else pts\n   245\t    if not (np.linalg.norm(np.diff(ring, axis=0), axis=1) > 0).all():\n   246\t        raise ValueError(\"a spline's points follow one another without repeating\")\n   247\t    if closed:\n   248\t        ext = np.vstack([pts[-1:], pts, pts[:2]])\n   249\t        spans = len(pts)\n   250\t    else:\n   251\t        ext = np.vstack([2 * pts[0] - pts[1], pts, 2 * pts[-1] - pts[-2]])\n   252\t        spans = len(pts) - 1\n   253\t    out = [refined(lambda s, p=ext[i:i + 4]: catmull_rom(p, s), 0.0, 1.0, 4, tolerance, closed=False)\n   254\t           for i in range(spans)]\n   255\t    if not closed:\n   256\t        out.append(pts[-1:])\n   257\t    return Curve(np.vstack(out), closed)\n   258\t\n   259\t\n   260\tdef catmull_rom(p: np.ndarray, s: np.ndarray, alpha: float = 0.5) -> np.ndarray:\n   261\t    \"\"\"Points of the centripetal (alpha 1/2) Catmull-Rom span between p[1] and p[2] at s in 0 to 1,\n   262\t    by the Barry and Goldman pyramid.\"\"\"\n   263\t    d = np.linalg.norm(np.diff(p, axis=0), axis=1) ** alpha\n   264\t    t = np.concatenate([[0.0], np.cumsum(d)])\n   265\t    tt = (t[1] + s * (t[2] - t[1]))[:, None]\n   266\t\n   267\t    def lerp(a, b, ta, tb):\n   268\t        return ((tb - tt) * a + (tt - ta) * b) / (tb - ta)\n   269\t\n   270\t    a1, a2, a3 = lerp(p[0], p[1], t[0], t[1]), lerp(p[1], p[2], t[1], t[2]), lerp(p[2], p[3], t[2], t[3])\n   271\t    b1, b2 = lerp(a1, a2, t[0], t[2]), lerp(a2, a3, t[1], t[3])\n   272\t    return lerp(b1, b2, t[1], t[2])\n   273\t\n   274\t\n   275\t# ---- planes ---------------------------------------------------------------------------------\n   276\t\n   277\t@dataclass(frozen=True)\n   278\tclass Plane:\n   279\t    \"\"\"A plane through `point` with the unit `normal`.\"\"\"\n   280\t    point: np.ndarray\n   281\t    normal: np.ndarray\n   282\t\n   283\t    def __post_init__(self):\n   284\t        object.__setattr__(self, \"point\", np.asarray(self.point, float))\n   285\t        object.__setattr__(self, \"normal\", unit(self.normal))\n   286\t\n   287\t    @classmethod\n   288\t    def fit(cls, points) -> Tuple[\"Plane\", float]:\n   289\t        \"\"\"The least-squares plane through three or more points and its root mean square residual\n   290\t        in mm.\"\"\"\n   291\t        pts = np.atleast_2d(np.asarray(points, float))\n   292\t        if len(pts) < 3 or pts.shape[1] != 3:\n   293\t            raise ValueError(\"a plane needs three or more points in three dimensions\")\n   294\t        centre = pts.mean(axis=0)\n   295\t        _, sv, vt = np.linalg.svd(pts - centre, full_matrices=False)\n   296\t        if not sv[1] > 1e-12 * max(1.0, float(sv[0])):\n   297\t            raise ValueError(\"the points lie on one line\")\n   298\t        return cls(centre, vt[2]), float(sv[2] / math.sqrt(len(pts)))\n   299\t\n   300\t    def distance(self, points) -> np.ndarray:\n   301\t        \"\"\"Each point's signed distance from the plane, positive on the normal's side.\"\"\"\n   302\t        return (np.atleast_2d(np.asarray(points, float)) - self.point) @ self.normal\n   303\t\n   304\t    def angle_deg(self, other: \"Plane\") -> float:\n   305\t        \"\"\"The angle between the two planes, 0 to 90 degrees.\"\"\"\n   306\t        c = min(1.0, abs(float(self.normal @ other.normal)))\n   307\t        return math.degrees(math.acos(c))\n   308\t\n   309\t    def meet(self, a, b) -> Optional[np.ndarray]:\n   310\t        \"\"\"Where the line through a and b meets the plane, or None where it runs parallel.\"\"\"\n   311\t        a, b = np.asarray(a, float), np.asarray(b, float)\n   312\t        den = float((b - a) @ self.normal)\n   313\t        if abs(den) < 1e-12 * max(1.0, float(np.linalg.norm(b - a))):\n   314\t            return None\n   315\t        return a + float((self.point - a) @ self.normal) / den * (b - a)\n   316\t\n   317\t    def seen_at_deg(self, camera: Camera) -> float:\n   318\t        \"\"\"The angle the render's ray through the plane's point makes with the plane: none where\n   319\t        the render sees the plane edge on, as a line, 90 degrees where it sees it face on.\"\"\"\n   320\t        d = camera.ray_direction(self.point)[0]\n   321\t        return math.degrees(math.asin(min(1.0, abs(float(d @ self.normal)))))\n   322\t\n   323\t    def patch(self, half_a: float, half_b: float, toward=None) -> \"Polygon\":\n   324\t        \"\"\"The rectangle of half sides half_a and half_b about the point, its first side along the\n   325\t        part of `toward` that lies in the plane where `toward` is given.\"\"\"\n   326\t        if toward is not None:\n   327\t            t = np.asarray(toward, float)\n   328\t            e1 = unit(t - (t @ self.normal) * self.normal)\n   329\t            e2 = np.cross(self.normal, e1)\n   330\t        else:\n   331\t            e1, e2 = across(self.normal)\n   332\t        corners = [self.point + sa * half_a * e1 + sb * half_b * e2 for sa, sb in ((-1, -1), (1, -1), (1, 1), (-1, 1))]\n   333\t        return Polygon(np.stack(corners))\n   334\t\n   335\t\n   336\t@dataclass(frozen=True)\n   337\tclass Polygon:\n   338\t    \"\"\"A flat polygon in the world, its corners in order.\"\"\"\n   339\t    corners: np.ndarray\n   340\t\n   341\t    def __post_init__(self):\n   342\t        pts = np.atleast_2d(np.asarray(self.corners, float))\n   343\t        if pts.shape[1] != 3 or len(pts) < 3:\n   344\t            raise ValueError(\"a polygon is three or more corners in three dimensions\")\n   345\t        object.__setattr__(self, \"corners\", pts)\n   346\t\n   347\t    def plane(self) -> Plane:\n   348\t        return Plane.fit(self.corners)[0]\n   349\t\n   350\t    def area(self) -> float:\n   351\t        \"\"\"The area in mm2, half the length of the sum of the corners' cross products.\"\"\"\n   352\t        c = self.corners - self.corners.mean(axis=0)\n   353\t        return 0.5 * float(np.linalg.norm(np.cross(c, np.roll(c, -1, axis=0)).sum(axis=0)))\n   354\t\n   355\t    def outline(self) -> Curve:\n   356\t        return Curve(self.corners, closed=True)\n   357\t\n   358\t    def project(self, camera: Camera) -> Curve2D:\n   359\t        return self.outline().project(camera)\n   360\t\n   361\t\n   362\t# ---- volumes --------------------------------------------------------------------------------\n   363\t\n   364\t@dataclass(frozen=True)\n   365\tclass Volume:\n   366\t    \"\"\"A set of voxels on a grid: mask[i, j, k] on the voxel whose centre the affine puts in the\n   367\t    world.\"\"\"\n   368\t    mask: np.ndarray\n   369\t    affine: np.ndarray\n   370\t\n   371\t    def __post_init__(self):\n   372\t        object.__setattr__(self, \"mask\", np.asarray(self.mask, bool))\n   373\t        object.__setattr__(self, \"affine\", np.asarray(self.affine, float))\n   374\t        if self.mask.ndim != 3 or self.affine.shape != (4, 4):\n   375\t            raise ValueError(\"a volume is a three-dimensional mask and its four by four affine\")\n   376\t        if not self.mask.any():\n   377\t            raise ValueError(\"a volume of no voxels\")\n   378\t\n   379\t    @classmethod\n   380\t    def from_labels(cls, labels: np.ndarray, affine: np.ndarray, value, largest: bool = True) -> \"Volume\":\n   381\t        \"\"\"The voxels of one label value, or of any of several, their largest face-connected piece\n   382\t        alone where `largest`.\"\"\"\n   383\t        mask = np.isin(np.asarray(labels), np.atleast_1d(value))\n   384\t        if largest and mask.any():\n   385\t            parts, n = ndimage.label(mask)\n   386\t            if n > 1:\n   387\t                sizes = np.bincount(parts.ravel())\n   388\t                sizes[0] = 0\n   389\t                mask = parts == int(np.argmax(sizes))\n   390\t        return cls(mask, affine)\n   391\t\n   392\t    @property\n   393\t    def spacing(self) -> np.ndarray:\n   394\t        return np.linalg.norm(self.affine[:3, :3], axis=0)\n   395\t\n   396\t    def points(self) -> np.ndarray:\n   397\t        idx = np.argwhere(self.mask).astype(float)\n   398\t        return idx @ self.affine[:3, :3].T + self.affine[:3, 3]\n   399\t\n   400\t    def centroid(self) -> np.ndarray:\n   401\t        return self.points().mean(axis=0)\n   402\t\n   403\t    def volume_mm3(self) -> float:\n   404\t        return float(self.mask.sum()) * abs(float(np.linalg.det(self.affine[:3, :3])))\n   405\t\n   406\t    def box(self) -> Tuple[np.ndarray, np.ndarray]:\n   407\t        \"\"\"The voxel box the volume fills, from the low faces of its lowest voxels to the high faces\n   408\t        of its highest, in voxel coordinates.\"\"\"\n   409\t        idx = np.argwhere(self.mask)\n   410\t        return idx.min(axis=0) - 0.5, idx.max(axis=0) + 0.5\n   411\t\n   412\t    def corners(self) -> np.ndarray:\n   413\t        \"\"\"The box's eight corners in the world.\"\"\"\n   414\t        lo, hi = self.box()\n   415\t        c = np.array([[x, y, z] for x in (lo[0], hi[0]) for y in (lo[1], hi[1]) for z in (lo[2], hi[2])])\n   416\t        return c @ self.affine[:3, :3].T + self.affine[:3, 3]\n   417\t\n   418\t    def footprint(self, camera: Camera) -> np.ndarray:\n   419\t        \"\"\"The pixels (row, column) whose rays can meet the volume: the bounding rectangle of the box's\n   420\t        projected corners, on the detector.\"\"\"\n   421\t        got = camera.project(self.corners())\n   422\t        if not camera.view.orthographic and not bool((got.depth > 0).all()):\n   423\t            raise ValueError(\"the volume reaches behind the source\")\n   424\t        c0, r0 = np.floor(got.uv.min(axis=0)).astype(int)\n   425\t        c1, r1 = np.ceil(got.uv.max(axis=0)).astype(int)\n   426\t        rows = np.arange(max(r0, 0), min(r1, camera.view.height))\n   427\t        cols = np.arange(max(c0, 0), min(c1, camera.view.width))\n   428\t        r, c = np.meshgrid(rows, cols, indexing=\"ij\")\n   429\t        return np.stack([r.ravel(), c.ravel()], axis=1)\n   430\t\n   431\t    def path_length(self, camera: Camera, step: Optional[float] = None, n_samples: Optional[int] = None,\n   432\t                    chunk: int = 4096) -> np.ndarray:\n   433\t        \"\"\"The length in mm each of the render's rays runs through the volume, an image of the\n   434\t        detector's size: by the fine sampling, at most `step` mm apart (half the smallest voxel\n   435\t        spacing unless given) through the volume's box, or, with n_samples, by FleXray's sampling of\n   436\t        the whole ray from the source to the detector.\"\"\"\n   437\t        if n_samples is not None and n_samples < 2:\n   438\t            raise ValueError(\"FleXray samples a ray at two points or more\")\n   439\t        out = np.zeros((camera.view.height, camera.view.width))\n   440\t        pix = self.footprint(camera)\n   441\t        to_voxel = np.linalg.inv(self.affine)\n   442\t        lo, hi = self.box()\n   443\t        for i in range(0, len(pix), chunk):\n   444\t            part = pix[i:i + chunk]\n   445\t            src, tgt = camera.rays(part[:, ::-1] + 0.5)\n   446\t            a = src @ to_voxel[:3, :3].T + to_voxel[:3, 3]\n   447\t            b = tgt @ to_voxel[:3, :3].T + to_voxel[:3, 3]\n   448\t            length = np.linalg.norm(tgt - src, axis=1)\n   449\t            if n_samples is not None:\n   450\t                got = self.flexray_samples(a, b, length, int(n_samples), lo, hi)\n   451\t            else:\n   452\t                got = self.fine_samples(a, b, length, lo, hi, step or 0.5 * float(self.spacing.min()))\n   453\t            out[part[:, 0], part[:, 1]] = got\n   454\t        return out\n   455\t\n   456\t    def silhouette(self, camera: Camera, **kwargs) -> np.ndarray:\n   457\t        \"\"\"Where the render's rays meet the volume.\"\"\"\n   458\t        return self.path_length(camera, **kwargs) > 0\n   459\t\n   460\t    def inside(self, ijk: np.ndarray) -> np.ndarray:\n   461\t        \"\"\"Whether each voxel coordinate's nearest voxel is the volume's, rounding half to even as\n   462\t        grid_sample's nearest mode does; a place off the grid is not.\"\"\"\n   463\t        idx = np.rint(ijk).astype(np.int64)\n   464\t        shape = np.array(self.mask.shape)\n   465\t        ok = np.all((idx >= 0) & (idx < shape), axis=-1)\n   466\t        hit = np.zeros(idx.shape[:-1], bool)\n   467\t        hit[ok] = self.mask[idx[ok][:, 0], idx[ok][:, 1], idx[ok][:, 2]]\n   468\t        return hit\n   469\t\n   470\t    def flexray_samples(self, a: np.ndarray, b: np.ndarray, length: np.ndarray, n: int, lo: np.ndarray,\n   471\t                        hi: np.ndarray) -> np.ndarray:\n   472\t        \"\"\"nanoDRR's sampling: n points from the source to the detector at t = k / (n - 1), the\n   473\t        step the ray's length over n - 1, each point weighing one step where its nearest voxel is\n   474\t        the volume's. Only the points within a step of the volume's box are read, since no other\n   475\t        point's nearest voxel can be the volume's.\"\"\"\n   476\t        t0, t1 = slab(a, b, lo, hi)\n   477\t        k0 = np.clip(np.floor(t0 * (n - 1)).astype(np.int64) - 1, 0, n - 1)\n   478\t        k1 = np.clip(np.ceil(t1 * (n - 1)).astype(np.int64) + 1, 0, n - 1)\n   479\t        width = int((k1 - k0).max(initial=-1)) + 1\n   480\t        hits = np.zeros(len(a))\n   481\t        for j in range(0, max(width, 0), 256):\n   482\t            ks = k0[:, None] + np.arange(j, min(width, j + 256))[None, :]\n   483\t            valid = ks <= k1[:, None]\n   484\t            t = ks / float(n - 1)\n   485\t            pts = a[:, None, :] + t[:, :, None] * (b - a)[:, None, :]\n   486\t            hits += (self.inside(pts) & valid).sum(axis=1)\n   487\t        return hits * length / (n - 1)\n   488\t\n   489\t    def fine_samples(self, a: np.ndarray, b: np.ndarray, length: np.ndarray, lo: np.ndarray, hi: np.ndarray,\n   490\t                     step: float) -> np.ndarray:\n   491\t        \"\"\"The chord through the volume's box, sampled at the midpoints of steps at most `step` mm\n   492\t        long, each step counted where its midpoint's nearest voxel is the volume's.\"\"\"\n   493\t        t0, t1 = slab(a, b, lo, hi)\n   494\t        span = np.clip(t1 - t0, 0.0, None) * length\n   495\t        n = int(math.ceil(float(span.max(initial=0.0)) / step)) if span.size else 0\n   496\t        if n == 0:\n   497\t            return np.zeros(len(a))\n   498\t        hits = np.zeros(len(a))\n   499\t        for k in range(0, n, 256):\n   500\t            s = (np.arange(k, min(n, k + 256)) + 0.5) / n\n   501\t            tk = t0[:, None] + s[None, :] * (t1 - t0)[:, None]\n   502\t            pts = a[:, None, :] + tk[:, :, None] * (b - a)[:, None, :]\n   503\t            hits += self.inside(pts).sum(axis=1)\n   504\t        return hits * span / n\n   505\t\n   506\t\n   507\tdef slab(a: np.ndarray, b: np.ndarray, lo: np.ndarray, hi: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:\n   508\t    \"\"\"Where each segment from a to b enters and leaves the box from lo to hi, as fractions of the\n   509\t    segment, by the slab method; an entry after the exit means it misses.\"\"\"\n   510\t    d = b - a\n   511\t    parallel = d == 0\n   512\t    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n   513\t        ta, tb = (lo - a) / d, (hi - a) / d\n   514\t    near = np.where(parallel, -np.inf, np.minimum(ta, tb))\n   515\t    far = np.where(parallel, np.inf, np.maximum(ta, tb))\n   516\t    outside = parallel & ((a < lo) | (a > hi))\n   517\t    t0 = np.clip(near.max(axis=1), 0.0, 1.0)\n   518\t    t1 = np.clip(far.min(axis=1), 0.0, 1.0)\n   519\t    t1 = np.where(outside.any(axis=1), t0 - 1.0, t1)\n   520\t    return t0, t1\n   521\t\n   522\t\n   523\tdef project_points(points, camera: Camera) -> Projected:\n   524\t    \"\"\"Points of any number onto the render, as projection.Camera.project.\"\"\"\n   525\t    return camera.project(np.atleast_2d(np.asarray(points, float)))","is_error":false}]},"uuid":"ccecbc28-9acb-4259-8fb3-e2a42af38020","timestamp":"2026-10-30T18:11:02.734Z","serverClassifierContext":{"request":"0c65bcab-f3ba-4a9b-96c1-a46ced08b156","context":{"git_state":{"cwd":"/home/user/bordercall","root":"/home/user/bordercall","branch":"claude/project-thread-gv744i","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":6},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"OpenSpineConsortium/symphony-template","visibility":"unknown"},{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"},{"host":"github.com","remote":"OpenSpineConsortium/SchwingNet","visibility":"unknown"}]}},"live_cwd":"/home/user/bordercall","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"fbfbc8d1-a486-4def-b154-ef6329b140e1","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"remote_projects","cwd":"/home/user/bordercall","sessionId":"cbdcd57f-bcf8-5a71-ab64-4f0b9fbdb74f","version":"2.1.314","gitBranch":"HEAD","slug":"zany-kindling-liskov"}
