{"parentUuid":"61d6e8ba-19a3-447d-adfa-289138bf0622","isSidechain":true,"promptId":"b181e0eb-34fb-4b99-8009-91607af5aeb8","agentId":"af4ae0306e46b6e08","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BBeVpaMxYDNrN2fkguG7pR","type":"tool_result","content":"94:def euler_to_rotmat(convention: str, angles, degrees=False, dtype=None, device=None):\n95-    r\"\"\"\n96-    Convert Euler angles to rotation matrix representation.\n97-\n98-    Args:\n99-        convention (string): 'xyz' for example. See :func:`~roma.euler.euler_to_unitquat()`.\n100-        angles (...xD tensor, or tuple/list of D floats or ... tensors): a list of angles associated to each axis, expressed in radians by default.\n101-        degrees (bool): if True, input angles are assumed to be expressed in degrees.\n102-\n103-    Returns:\n104-        a batch of rotation matrices (...x3x3 tensor).\n105-    \"\"\"\n106-    return roma.unitquat_to_rotmat(\n107-        euler_to_unitquat(convention=convention, angles=angles, degrees=degrees, dtype=dtype, device=device)\n108-    )\n109-\n110-\n111-def unitquat_to_euler(convention: str, quat, as_tuple=False, degrees=False, epsilon=1e-7):\n112-    r\"\"\"\n113-    Convert unit quaternion to Euler angles representation.\n114-\n115-    Args:\n116-        convention (str): string of 3 characters belonging to {'x', 'y', 'z'} for extrinsic rotations, or {'X', 'Y', 'Z'} for intrinsic rotations.\n117-            Consecutive axes should not be identical.\n118-        quat (...x4 tensor, XYZW convention): input batch of unit quaternion.\n119-        as_tuple (boolean): if True, angles are not stacked but returned as a tuple of tensors.\n120-        degrees (bool): if True, angles are returned in degrees.\n121-        epsilon (float): a small value used to detect degenerate configurations.\n122-\n123-    Returns:\n124-        A stacked ...x3 tensor corresponding to Euler angles, expressed by default in radians.\n125-        In case of gimbal lock, the third angle is arbitrarily set to 0.\n126-    \"\"\"\n127-    # Code adapted from scipy.spatial.transform.Rotation.\n128-    # Reference: https://github.com/scipy/scipy/blob/ac6bcaf00411286271f7cc21e495192c73168ae4/scipy/spatial/transform/_rotation.pyx#L325C12-L325C15\n129-    assert len(convention) == 3\n130-\n131-    pi = math.pi\n132-    lamb = math.pi / 2\n133-\n134-    extrinsic = convention.islower()\n135-    if not extrinsic:\n136-        convention = convention.lower()[::-1]\n137-\n138-    quat, batch_shape = roma.internal.flatten_batch_dims(quat, end_dim=-2)\n139-    N = quat.shape[0]\n140-\n141-    i = _elementary_basis_index(convention[0])\n142-    j = _elementary_basis_index(convention[1])\n143-    k = _elementary_basis_index(convention[2])\n144-    assert i != j and j != k, \"Consecutive axes should not be identical.\"\n145-\n146-    symmetric = i == k\n147-\n148-    if symmetric:\n149-        # Get third axis\n150-        k = 3 - i - j\n151-\n152-    # Step 0\n153-    # Check if permutation is even (+1) or odd (-1)\n154-    sign = (i - j) * (j - k) * (k - i) // 2","is_error":false}]},"uuid":"71b3d48a-a9c7-4479-8ff2-594a0e4e6306","timestamp":"2026-10-30T18:11:26.068Z","serverClassifierContext":{"request":"250654fd-77c8-4d18-8f1a-abfb97535283","context":{"git_state":{"cwd":"/home/user/bordercall","root":"/home/user/bordercall","branch":"claude/project-thread-gv744i","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":6},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"OpenSpineConsortium/symphony-template","visibility":"unknown"},{"host":"github.com","remote":"OpenSpineConsortium/bordercall","visibility":"u